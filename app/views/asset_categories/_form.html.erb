<%= form_with model: asset_category, class: "contents" do |form| %>
  <%= render "shared/form_errors", record: asset_category %>

  <div class="my-5">
    <%= form.label :name, "Nama kategori", class: "block text-sm font-medium" %>
    <p class="text-xs text-gray-500">Slug dibuat otomatis dari nama.</p>
    <%= form.text_field :name, placeholder: "Laptop", autofocus: true,
          class: "mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
    <%= link_to "Batal", asset_categories_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
