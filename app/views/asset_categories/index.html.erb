<% content_for :title, "Kategori aset" %>

<div class="flex items-center justify-between gap-4">
  <div>
    <%= link_to "← Katalog", assets_path, class: "text-sm text-gray-600 hover:underline" %>
    <h1 class="mt-1 text-3xl font-bold">Kategori aset</h1>
  </div>
  <%= link_to "Tambah kategori", new_asset_category_path,
        class: "rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
</div>

<% if @asset_categories.any? %>
  <div class="mt-6 overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3">Nama</th>
          <th class="px-4 py-3">Slug</th>
          <th class="px-4 py-3">Jumlah aset</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @asset_categories.each do |category| %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= category.name %></td>
            <td class="px-4 py-3 font-mono text-xs text-gray-500"><%= category.slug %></td>
            <td class="px-4 py-3 text-gray-600"><%= category.assets_count %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex justify-end gap-3">
                <%= link_to "Ubah", edit_asset_category_path(category), class: "text-blue-600 hover:underline" %>
                <%= button_to "Hapus", category, method: :delete,
                      form: { data: { turbo_confirm: "Hapus kategori #{category.name}?" } },
                      class: "cursor-pointer text-red-600 hover:underline" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="mt-6 rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
    Belum ada kategori. Tambahkan dulu sebelum mendaftarkan aset.
  </p>
<% end %>
