<% content_for :title, @asset.name %>

<%= link_to "← Katalog", assets_path, class: "text-sm text-gray-600 hover:underline" %>

<div class="mt-4 grid gap-8 lg:grid-cols-3">
  <div class="lg:col-span-1">
    <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
      <% if @asset.photo.attached? %>
        <%= image_tag @asset.photo, class: "w-full object-cover", alt: @asset.name %>
      <% else %>
        <div class="flex h-52 items-center justify-center bg-gray-100 text-sm text-gray-400">Tanpa foto</div>
      <% end %>
    </div>
  </div>

  <div class="lg:col-span-2">
    <p class="text-xs font-medium uppercase tracking-wide text-blue-600"><%= @asset.asset_category.name %></p>
    <h1 class="mt-1 text-3xl font-bold"><%= @asset.name %></h1>
    <% if @asset.description.present? %>
      <p class="mt-3 whitespace-pre-line text-gray-700"><%= @asset.description %></p>
    <% end %>

    <% if current_user.asset_admin? %>
      <div class="mt-5 flex flex-wrap gap-2">
        <%= link_to "Ubah aset", edit_asset_path(@asset),
              class: "rounded-md border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium hover:bg-gray-50" %>
        <%= link_to "Tambah unit", new_asset_asset_unit_path(@asset),
              class: "rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
        <%= button_to "Hapus aset", @asset, method: :delete,
              form: { data: { turbo_confirm: "Hapus #{@asset.name} beserta semua unitnya?" } },
              class: "cursor-pointer rounded-md border border-red-200 bg-white px-3.5 py-2 text-sm font-medium text-red-600 hover:bg-red-50" %>
      </div>
    <% end %>

    <h2 class="mt-8 text-lg font-semibold">Unit fisik</h2>

    <% if @asset_units.any? %>
      <div class="mt-3 overflow-x-auto rounded-lg border border-gray-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-4 py-3">Tag aset</th>
              <th class="px-4 py-3">Nomor seri</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Kondisi</th>
              <% if current_user.asset_admin? %><th class="px-4 py-3"></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @asset_units.each do |unit| %>
              <tr>
                <td class="px-4 py-3 font-medium"><%= unit.asset_tag %></td>
                <td class="px-4 py-3 text-gray-600"><%= unit.serial_number %></td>
                <td class="px-4 py-3"><%= unit_status_badge unit %></td>
                <td class="px-4 py-3"><%= unit_condition_badge unit %></td>
                <% if current_user.asset_admin? %>
                  <td class="px-4 py-3 text-right">
                    <%= link_to "Ubah", edit_asset_asset_unit_path(@asset, unit),
                          class: "text-blue-600 hover:underline" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-gray-500">
        Belum ada unit fisik untuk aset ini.
      </p>
    <% end %>
  </div>
</div>
