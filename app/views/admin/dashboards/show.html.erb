<% content_for :title, "Laporan" %>

<h1 class="text-3xl font-bold">Laporan</h1>
<p class="mt-1 text-gray-600">Ringkasan pemakaian aset IT per <%= l Date.current, format: :long %>.</p>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg border border-gray-200 bg-white p-5">
    <p class="text-xs uppercase tracking-wide text-gray-500">Unit berstatus tersedia</p>
    <p class="mt-2 text-3xl font-bold"><%= @unit_counts.fetch("available", 0) %></p>
    <p class="mt-1 text-sm text-gray-500">dari <%= @active_units %> unit aktif</p>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-5">
    <p class="text-xs uppercase tracking-wide text-gray-500">Sedang dipegang peminjam</p>
    <p class="mt-2 text-3xl font-bold"><%= @units_in_hand %></p>
    <p class="mt-1 text-sm text-gray-500">tingkat utilisasi <%= @utilization %>%</p>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-5">
    <p class="text-xs uppercase tracking-wide text-gray-500">Menunggu persetujuan</p>
    <p class="mt-2 text-3xl font-bold"><%= @request_counts.fetch("pending", 0) %></p>
    <p class="mt-1 text-sm">
      <%= link_to "Buka antrian", admin_borrow_requests_path, class: "text-blue-600 hover:underline" %>
    </p>
  </div>

  <div class="rounded-lg border p-5 <%= @overdue.any? ? 'border-red-200 bg-red-50' : 'border-gray-200 bg-white' %>">
    <p class="text-xs uppercase tracking-wide <%= @overdue.any? ? 'text-red-600' : 'text-gray-500' %>">Terlambat kembali</p>
    <p class="mt-2 text-3xl font-bold <%= 'text-red-700' if @overdue.any? %>"><%= @overdue.size %></p>
    <p class="mt-1 text-sm text-gray-500">peminjaman lewat tanggal</p>
  </div>
</div>

<div class="mt-6 grid gap-5 lg:grid-cols-2">
  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="font-semibold">Aset paling sering dipinjam</h2>

    <% if @most_borrowed.any? %>
      <ol class="mt-3 divide-y divide-gray-100">
        <% @most_borrowed.each do |asset| %>
          <li class="flex items-center justify-between gap-4 py-2.5 text-sm">
            <%= link_to asset.name, asset, class: "font-medium hover:text-blue-600 hover:underline" %>
            <span class="shrink-0 text-gray-500"><%= asset.borrow_count %>×</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">Belum ada peminjaman yang disetujui.</p>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="font-semibold">Peminjam paling aktif</h2>

    <% if @top_borrowers.any? %>
      <ol class="mt-3 divide-y divide-gray-100">
        <% @top_borrowers.each do |borrower| %>
          <li class="flex items-center justify-between gap-4 py-2.5 text-sm">
            <span>
              <span class="font-medium"><%= borrower.name %></span>
              <span class="text-gray-500">· <%= borrower.department %></span>
            </span>
            <span class="shrink-0 text-gray-500"><%= borrower.borrow_count %>×</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">Belum ada peminjam.</p>
    <% end %>
  </section>
</div>

<section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
  <h2 class="font-semibold">Peminjaman terlambat</h2>

  <% if @overdue.any? %>
    <ul class="mt-3 divide-y divide-gray-100">
      <% @overdue.each do |borrow_request| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-2.5 text-sm">
          <span>
            <%= link_to "#{borrow_request.asset_unit.asset.name} · #{borrow_request.asset_unit.asset_tag}",
                  borrow_request, class: "font-medium hover:text-blue-600 hover:underline" %>
            <span class="text-gray-500">· <%= borrow_request.user.name %></span>
          </span>
          <span class="text-red-700">
            jatuh tempo <%= l borrow_request.end_on, format: :long %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">Tidak ada yang terlambat. Semua barang kembali tepat waktu.</p>
  <% end %>
</section>

<section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
  <h2 class="font-semibold">Unit di luar peredaran</h2>
  <p class="mt-1 text-sm text-gray-500">Unit ini tidak muncul di pencarian ketersediaan.</p>

  <% if @units_out_of_service.any? %>
    <ul class="mt-3 divide-y divide-gray-100">
      <% @units_out_of_service.each do |unit| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-2.5 text-sm">
          <span>
            <span class="font-medium"><%= unit.asset_tag %></span>
            <span class="text-gray-500">· <%= unit.asset.name %></span>
          </span>
          <span class="flex gap-2">
            <%= unit_condition_badge unit %>
            <%= unit_status_badge unit %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">Semua unit dalam keadaan siap pakai.</p>
  <% end %>
</section>

<section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
  <h2 class="font-semibold">Sebaran status pengajuan</h2>

  <div class="mt-3 flex flex-wrap gap-4 text-sm">
    <% BorrowRequest::STATUSES.each_key do |status| %>
      <div>
        <p class="text-gray-500"><%= t "borrow_request.statuses.#{status}" %></p>
        <p class="text-lg font-semibold"><%= @request_counts.fetch(status.to_s, 0) %></p>
      </div>
    <% end %>
  </div>
</section>
