<% content_for :title, "Antrian peminjaman" %>

<h1 class="text-3xl font-bold">Antrian peminjaman</h1>
<p class="mt-1 text-gray-600">Pengajuan dari seluruh karyawan.</p>

<nav class="mt-6 flex flex-wrap gap-2">
  <% Admin::BorrowRequestsController::TABS.each do |tab| %>
    <%= link_to admin_borrow_requests_path(status: tab),
          class: "rounded-full px-3 py-1 text-sm #{@tab == tab ? 'bg-gray-900 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" do %>
      <%= t "borrow_request.statuses.#{tab}" %>
      <span class="ml-1 text-xs opacity-70"><%= @counts.fetch(tab, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @borrow_requests.any? %>
  <div class="mt-6 space-y-3">
    <% @borrow_requests.each do |borrow_request| %>
      <% unit = borrow_request.asset_unit %>
      <article class="rounded-lg border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="font-semibold text-gray-900">
              <%= borrow_request.user.name %>
              <span class="ml-1 text-sm font-normal text-gray-500"><%= borrow_request.user.department %></span>
            </h2>
            <p class="mt-0.5 text-sm text-gray-500">
              <%= link_to "#{unit.asset.name} · unit #{unit.asset_tag}", borrow_request,
                    class: "hover:text-blue-600 hover:underline" %>
            </p>
            <p class="mt-0.5 text-sm text-gray-500">
              <%= borrow_date_range borrow_request %> (<%= borrow_request.duration_days %> hari)
            </p>
          </div>

          <%= borrow_status_badge borrow_request %>
        </div>

        <p class="mt-3 whitespace-pre-line text-sm text-gray-700"><%= borrow_request.purpose %></p>

        <% if borrow_request.decided_by.present? %>
          <p class="mt-3 text-sm text-gray-500">
            Diputuskan <%= borrow_request.decided_by.name %>
            pada <%= l borrow_request.decided_at, format: :long %>.
            <% if borrow_request.rejection_reason.present? %>
              Alasan: <%= borrow_request.rejection_reason %>
            <% end %>
          </p>
        <% end %>

        <% if current_user.asset_admin? && borrow_request.next_handover_kind.present? %>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <% next_kind = t("handover_check.kinds.#{borrow_request.next_handover_kind}").downcase %>
            <%= link_to "Catat #{next_kind}", new_borrow_request_handover_check_path(borrow_request),
                  class: "rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
          </div>
        <% end %>

        <% if borrow_request.pending? && current_user.asset_admin? %>
          <div class="mt-4 flex flex-wrap items-start gap-2 border-t border-gray-100 pt-4">
            <%= button_to "Setujui", approve_admin_borrow_request_path(borrow_request), method: :patch,
                  class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-500" %>

            <details class="w-full sm:w-auto">
              <summary class="inline-block cursor-pointer list-none rounded-md border border-red-200 bg-white px-3.5 py-2 text-sm font-medium text-red-600 hover:bg-red-50">
                Tolak
              </summary>

              <%= form_with url: reject_admin_borrow_request_path(borrow_request), method: :patch,
                    class: "mt-2 flex flex-wrap items-center gap-2" do %>
                <%= text_field_tag :rejection_reason, nil, required: true,
                      placeholder: "Alasan penolakan",
                      class: "w-72 rounded-md border border-gray-300 px-3 py-2 text-sm" %>
                <%= submit_tag "Kirim penolakan",
                      class: "cursor-pointer rounded-md bg-red-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-red-500" %>
              <% end %>
            </details>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
    Tidak ada pengajuan berstatus <%= t "borrow_request.statuses.#{@tab}" %>.
  </p>
<% end %>
