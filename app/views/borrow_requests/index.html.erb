<% content_for :title, "Peminjaman saya" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold">Peminjaman saya</h1>
    <p class="mt-1 text-gray-600">Semua pengajuan yang pernah kamu kirim.</p>
  </div>

  <%= link_to "Cari aset", assets_path,
        class: "rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
</div>

<% if @borrow_requests.any? %>
  <div class="mt-6 space-y-3">
    <% @borrow_requests.each do |borrow_request| %>
      <% unit = borrow_request.asset_unit %>
      <article class="rounded-lg border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="font-semibold text-gray-900"><%= unit.asset.name %></h2>
            <p class="mt-0.5 text-sm text-gray-500">
              Unit <%= unit.asset_tag %> · <%= borrow_date_range borrow_request %>
              (<%= borrow_request.duration_days %> hari)
            </p>
          </div>

          <div class="flex items-center gap-3">
            <%= borrow_status_badge borrow_request %>
            <% if borrow_request.cancellable? %>
              <%= button_to "Batalkan", cancel_borrow_request_path(borrow_request), method: :patch,
                    form: { data: { turbo_confirm: "Batalkan peminjaman #{unit.asset_tag}?" } },
                    class: "cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
            <% end %>
          </div>
        </div>

        <p class="mt-3 whitespace-pre-line text-sm text-gray-700"><%= borrow_request.purpose %></p>

        <% if borrow_request.rejected? && borrow_request.rejection_reason.present? %>
          <p class="mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
            Alasan penolakan: <%= borrow_request.rejection_reason %>
          </p>
        <% end %>

        <% if borrow_request.overdue? %>
          <p class="mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
            Sudah lewat tanggal kembali. Segera kembalikan ke Admin Aset.
          </p>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
    Belum ada peminjaman. Mulai dari <%= link_to "katalog aset", assets_path, class: "text-blue-600 hover:underline" %>.
  </p>
<% end %>
