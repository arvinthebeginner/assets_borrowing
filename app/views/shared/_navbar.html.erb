<header class="border-b border-gray-200 bg-white">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4">
    <%= link_to root_path, class: "text-lg font-bold text-gray-900" do %>
      Pinjam<span class="text-blue-600">Aset</span>
    <% end %>

    <% if authenticated? %>
      <div class="mr-auto flex items-center gap-4 text-sm">
        <%= link_to "Katalog", assets_path, class: "font-medium text-gray-700 hover:text-blue-600" %>
        <% if current_user.asset_admin? %>
          <%= link_to "Kategori", asset_categories_path, class: "font-medium text-gray-700 hover:text-blue-600" %>
        <% end %>
      </div>

      <div class="flex items-center gap-4 text-sm">
        <span class="hidden text-gray-500 sm:inline">
          <%= current_user.name %>
          <span class="ml-1 rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
            <%= t "roles.#{current_user.role}" %>
          </span>
        </span>
        <%= button_to "Keluar", session_path, method: :delete,
              class: "rounded-md px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-100 cursor-pointer" %>
      </div>
    <% end %>
  </nav>
</header>
