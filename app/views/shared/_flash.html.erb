<% if alert = flash[:alert] %>
  <p id="alert" class="mb-5 inline-block rounded-lg bg-red-50 px-3 py-2 font-medium text-red-600"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p id="notice" class="mb-5 inline-block rounded-lg bg-green-50 px-3 py-2 font-medium text-green-700"><%= notice %></p>
<% end %>
