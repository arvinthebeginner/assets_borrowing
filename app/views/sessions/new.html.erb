<% content_for :title, "Masuk" %>

<div class="mx-auto w-full max-w-md rounded-lg border border-gray-200 bg-white p-8">
  <h1 class="text-2xl font-bold">Masuk</h1>
  <p class="mt-1 text-sm text-gray-500">Gunakan email kantor kamu.</p>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            placeholder: "nama@kantor.co.id", value: params[:email_address],
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            placeholder: "Kata sandi", maxlength: 72,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>

    <%= form.submit "Masuk",
          class: "w-full cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Lupa kata sandi?", new_password_path, class: "text-gray-600 underline hover:no-underline" %>
  </p>
</div>
